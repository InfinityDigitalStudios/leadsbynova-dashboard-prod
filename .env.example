# Fork Isolation Configuration
# Each fork MUST have its own unique values for these variables
# Copy this file to .env and fill in your specific values

# =============================================================================
# REQUIRED: Fork Identity
# =============================================================================
# Unique identifier for your fork (letters, numbers, hyphens, underscores only)
# Examples: my-realestate-app, johns-leads, tampa-properties
FORK_ID=your-unique-fork-name

# =============================================================================
# REQUIRED: Database Configuration  
# =============================================================================
# Each fork MUST have its own separate database for data isolation
# Get this from your PostgreSQL provider (Neon, Supabase, etc.)
DATABASE_URL=postgresql://username:password@host:port/database_name

# =============================================================================
# REQUIRED: Email Notifications
# =============================================================================
# Email address that will receive lead notifications for this fork
# Each fork should use a different email to prevent confusion
EMAIL_TO=your-email@domain.com

# =============================================================================
# OPTIONAL: Fork Description
# =============================================================================
# Human-readable description of this fork (for identification purposes)
FORK_DESCRIPTION="My Real Estate Lead Generation App"

# =============================================================================
# STANDARD: Application Configuration  
# =============================================================================
# Application environment (development, production, test)
NODE_ENV=development

# Port for the application (default: 5000)
PORT=5000

# =============================================================================
# DEVELOPMENT ONLY: Security Overrides (DANGER!)
# =============================================================================
# These variables allow bypassing fork isolation for development/testing
# DO NOT use in production - they defeat the security model
# OVERRIDE_ALLOW_SHARED_DB=true
# CONFIRM_SHARED_DB_RISK=I_UNDERSTAND_DATA_ISOLATION_RISK

# =============================================================================
# Email Service Configuration (for sending guides)
# =============================================================================
# If using Gmail for sending welcome emails
# GMAIL_USER=your-gmail@gmail.com
# GMAIL_APP_PASSWORD=your-app-specific-password

# If using SendGrid for sending welcome emails  
# SENDGRID_API_KEY=your-sendgrid-api-key
# SENDGRID_FROM_EMAIL=noreply@yourdomain.com